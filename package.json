{
  "name": "ghostts",
  "version": "1.0.0",
  "description": "A tool that let you run TS file without setting up TS project.",
  "main": "dist/cli/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/cli/index.js",
    "dev:watch": "tsc -w"
  },
  "keywords": [
    "typescript",
    "ts",
    "node",
    "compiler",
    "runner",
    "build",
    "zero-config",
    "types",
    "esbuild"
  ],
  "author": "Aniket mahajananiket@207gmail.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniketmahajan04/GhostTs"
  },
  "bugs": {
    "url": "https://github.com/aniketmahajan04/GhostTs/issues"
  },
  "type": "commonjs",
  "dependencies": {
    "chokidar": "^4.0.3",
    "colorette": "^2.0.20",
    "commander": "^14.0.0",
    "esbuild": "^0.25.9"
  },
  "bin": {
    "ghostts": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/chokidar": "^1.7.5",
    "@types/commander": "^2.12.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.3.1",
    "@types/prettier": "^2.7.3",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
